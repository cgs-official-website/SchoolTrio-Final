{
  "name": "schooltrio-platform",
  "version": "1.0.0",
  "private": true,
  "description": "SchoolTrio SaaS - Full Stack Educational Platform",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start:backend": "cd backend && node src/server.js",
    "build:backend": "cd backend && npx prisma generate",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  }
}
