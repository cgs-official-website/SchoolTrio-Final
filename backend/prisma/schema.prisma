// ============================================================
// 15. PLATFORM SUPPORT TICKET MODELS (2 models)
// ============================================================

model SupportTicket {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  ticketNumber String   @unique @map("ticket_number") @db.VarChar(50)
  subject      String   @db.VarChar(255)
  description  String   @db.Text
  category     String   @default("general") @db.VarChar(50)
  priority     String   @default("medium") @db.VarChar(20)
  status       String   @default("open") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school   School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportTicketMessage[]

  @@unique([schoolId, id])
  @@index([schoolId, status])
  @@index([schoolId, createdAt])
  @@index([status, priority])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id             String   @id @default(uuid()) @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  senderId       String?  @map("sender_id") @db.Uuid
  senderRole     String   @map("sender_role") @db.VarChar(50)
  senderName     String   @map("sender_name") @db.VarChar(200)
  message        String   @db.Text
  attachments    Json?
  isInternalNote Boolean  @default(false) @map("is_internal_note")
  createdAt      DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User?          @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

