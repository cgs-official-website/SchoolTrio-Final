// Prisma schema for School Management System SaaS
// Phase 2B: Authoritative 58-Model Multi-Tenant Relational Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. PLATFORM GLOBAL MODELS (4 models)
// ============================================================

model School {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(255)
  code              String   @unique @db.VarChar(50)
  type              String?  @db.VarChar(50)
  status            String   @default("pending") @db.VarChar(30)
  seatLimit         Int?     @map("seat_limit")
  teacherLimit      Int?     @map("teacher_limit")
  timezone          String   @default("Asia/Kolkata") @db.VarChar(50)
  logoUrl           String?  @map("logo_url") @db.Text
  email             String?  @unique @db.VarChar(255)
  phone             String?  @db.VarChar(20)
  address           String?  @db.Text
  apiKeysEncrypted  Json?    @map("api_keys_encrypted")
  planId            String?  @map("plan_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  legacyFirestoreId String?  @map("legacy_firestore_id") @db.VarChar(128)

  plan                   SubscriptionPlan?       @relation(fields: [planId], references: [id], onDelete: SetNull)
  users                  User[]
  settings               SchoolSetting[]
  roles                  SchoolRole[]
  classCategories        ClassCategory[]
  classes                Class[]
  subjects               Subject[]
  academicCalendarEvents AcademicCalendarEvent[]
  lessonPlans            LessonPlan[]
  academicResources      AcademicResource[]
  students               Student[]
  parentProfiles         ParentProfile[]
  staffProfiles          StaffProfile[]
  examinations           Examination[]
  feeCollectionPeriods   FeeCollectionPeriod[]
  libraryCategories      LibraryCategory[]
  libraryBooks           LibraryBook[]
  transportVehicles      TransportVehicle[]
  transportRoutes        TransportRoute[]
  inventoryCategories    InventoryCategory[]
  inventoryItems         InventoryItem[]
  broadcastChannels      BroadcastChannel[]
  notices                Notice[]
  notifications          Notification[]
  leaveApplications      LeaveApplication[]
  leaveApprovalRules     LeaveApprovalRule[]
  complaints             Complaint[]
  customModules          CustomModule[]
  customFormSchemas      CustomFormSchema[]
  admissionLeads         AdmissionLead[]
  leadForms              LeadForm[]
  admissionApplications  AdmissionApplication[]
  auditLogs              AuditLog[]
  reportCardTemplates    ReportCardTemplate[]
  supportTickets         SupportTicket[]

  @@map("schools")
}

model SubscriptionPlan {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @unique @db.VarChar(100)
  userLimit           Int      @map("user_limit")
  pricePerUserPerYear Decimal  @map("price_per_user_per_year") @db.Decimal(10, 2)
  cloudStorageGB      Int      @default(5) @map("cloud_storage_gb")
  modules             Json?
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  schools School[]

  @@map("subscription_plans")
}

model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  schoolId          String?  @map("school_id") @db.Uuid
  email             String   @unique @db.VarChar(255)
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  passwordAlgorithm String   @default("argon2id") @map("password_algorithm") @db.VarChar(50)
  systemRole        String   @default("TENANT_USER") @map("system_role") @db.VarChar(30)
  tokenVersion      Int      @default(1) @map("token_version")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  legacyFirestoreId String?  @map("legacy_firestore_id") @db.VarChar(128)

  school          School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  refreshSessions RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  staffProfile          StaffProfile?
  parentProfile         ParentProfile?
  roleAssignments       UserRoleAssignment[]
  supportTickets        SupportTicket[]
  supportTicketMessages SupportTicketMessage[]

  @@index([schoolId])
  @@map("users")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  deviceInfo String?   @map("device_info") @db.Text
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  tokenType String    @default("RESET") @map("token_type") @db.VarChar(30)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash, usedAt, expiresAt])
  @@map("password_reset_tokens")
}


// ============================================================
// 2. SYSTEM AUDIT MODELS (2 models)
// ============================================================

model MigrationIdMap {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  collectionName String   @map("collection_name") @db.VarChar(100)
  firestoreId    String   @map("firestore_id") @db.VarChar(128)
  postgresId     String   @map("postgres_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([schoolId, collectionName, firestoreId])
  @@index([schoolId, postgresId])
  @@map("migration_id_map")
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @map("school_id") @db.Uuid
  entityType      String   @map("entity_type") @db.VarChar(50)
  entityId        String?  @map("entity_id") @db.VarChar(128)
  actionPerformed String   @map("action_performed") @db.VarChar(100)
  userName        String   @map("user_name") @db.VarChar(200)
  userRole        String?  @map("user_role") @db.VarChar(50)
  modifiedFields  Json?    @map("modified_fields")
  timestamp       DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, entityType])
  @@index([schoolId, timestamp])
  @@map("audit_logs")
}

// ============================================================
// 3. TENANT JUNCTION MODELS (3 models)
// ============================================================

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  schoolRoleId String   @map("school_role_id") @db.Uuid
  moduleKey    String   @map("module_key") @db.VarChar(100)
  canRead      Boolean  @default(false) @map("can_read")
  canCreate    Boolean  @default(false) @map("can_create")
  canEdit      Boolean  @default(false) @map("can_edit")
  canDelete    Boolean  @default(false) @map("can_delete")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  schoolRole SchoolRole @relation(fields: [schoolRoleId], references: [id], onDelete: Cascade)

  @@unique([schoolRoleId, moduleKey])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  schoolRoleId String   @map("school_role_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolRole SchoolRole @relation(fields: [schoolRoleId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@unique([userId, schoolRoleId])
  @@index([schoolId, userId])
  @@map("user_role_assignments")
}

model ParentStudentLink {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @map("school_id") @db.Uuid
  parentProfileId String   @map("parent_profile_id") @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  relationship    String?  @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")

  parent  ParentProfile @relation(fields: [schoolId, parentProfileId], references: [schoolId, id], onDelete: Cascade)
  student Student       @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@unique([parentProfileId, studentId])
  @@index([schoolId, studentId])
  @@map("parent_student_links")
}

// ============================================================
// 4. TENANT SCOPED MODELS (49 models)
// ============================================================

model SchoolSetting {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  category  String   @db.VarChar(100)
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@unique([schoolId, category])
  @@map("school_settings")
}

model SchoolRole {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @map("school_id") @db.Uuid
  name            String   @db.VarChar(100)
  slug            String   @db.VarChar(100)
  loginPanel      String?  @map("login_panel") @db.VarChar(30)
  isSystemDefault Boolean  @default(false) @map("is_system_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  school             School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  permissions        RolePermission[]
  userAssignments    UserRoleAssignment[]
  leaveApprovalRules LeaveApprovalRule[]

  @@unique([schoolId, id])
  @@unique([schoolId, slug])
  @@map("school_roles")
}

model ClassCategory {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  name         String   @db.VarChar(100)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes Class[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@map("class_categories")
}

model Class {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  name           String   @db.VarChar(100)
  gradeLevel     Int?     @map("grade_level")
  classTeacherId String?  @map("class_teacher_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category      ClassCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  classTeacher  StaffProfile?  @relation("ClassTeacherRelation", fields: [classTeacherId], references: [id], onDelete: SetNull)
  sections      Section[]
  students      Student[]
  assignedStaff StaffProfile[] @relation("AssignedClassRelation")

  timetablePeriods      TimetablePeriod[]
  lessonPlans           LessonPlan[]
  academicResources     AcademicResource[]
  attendanceSessions    AttendanceSession[]
  absenteeFlags         AbsenteeFlag[]
  assessments           Assessment[]
  homeworkAssignments   HomeworkAssignment[]
  feeStructures         FeeStructure[]
  notices               Notice[]
  broadcastChannels     BroadcastChannel[]
  notifications         Notification[]
  ptmAppointments       PtmAppointment[]
  admissionApplications AdmissionApplication[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@map("classes")
}

model Section {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  name      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  class              Class               @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  students           Student[]
  timetablePeriods   TimetablePeriod[]
  attendanceSessions AttendanceSession[]

  @@unique([schoolId, id])
  @@unique([schoolId, classId, name])
  @@map("sections")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String   @db.VarChar(100)
  code      String?  @db.VarChar(50)
  credits   Decimal? @db.Decimal(3, 1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetablePeriods    TimetablePeriod[]
  lessonPlans         LessonPlan[]
  academicResources   AcademicResource[]
  assessments         Assessment[]
  homeworkAssignments HomeworkAssignment[]

  @@unique([schoolId, id])
  @@unique([schoolId, code])
  @@map("subjects")
}

model TimetablePeriod {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  classId      String   @map("class_id") @db.Uuid
  sectionId    String?  @map("section_id") @db.Uuid
  subjectId    String?  @map("subject_id") @db.Uuid
  teacherId    String?  @map("teacher_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week")
  periodNumber Int      @map("period_number")
  startTime    String   @map("start_time") @db.VarChar(10)
  endTime      String   @map("end_time") @db.VarChar(10)
  roomNumber   String?  @map("room_number") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  class   Class         @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  section Section?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subject Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher StaffProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, classId, dayOfWeek])
  @@map("timetable_periods")
}

model AcademicCalendarEvent {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  title       String   @db.VarChar(200)
  date        String   @db.VarChar(10)
  endDate     String?  @map("end_date") @db.VarChar(10)
  type        String   @db.VarChar(50)
  description String?  @db.Text
  audience    String   @default("all") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId, date])
  @@map("academic_calendar_events")
}

model LessonPlan {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid
  classId    String   @map("class_id") @db.Uuid
  subjectId  String   @map("subject_id") @db.Uuid
  weekNumber Int      @map("week_number")
  status     String   @default("Draft") @db.VarChar(30)
  topics     String?  @db.Text
  objectives String?  @db.Text
  customData Json?    @map("custom_data")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher StaffProfile @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Cascade)
  class   Class        @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  subject Subject      @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId, teacherId])
  @@map("lesson_plans")
}

model AcademicResource {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  title       String   @db.VarChar(200)
  classId     String   @map("class_id") @db.Uuid
  subjectId   String?  @map("subject_id") @db.Uuid
  uploaderId  String   @map("uploader_id") @db.Uuid
  fileUrl     String?  @map("file_url") @db.Text
  fileType    String?  @map("file_type") @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class    @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, classId])
  @@map("academic_resources")
}

model Student {
  id                String   @id @default(uuid()) @db.Uuid
  schoolId          String   @map("school_id") @db.Uuid
  classId           String?  @map("class_id") @db.Uuid
  sectionId         String?  @map("section_id") @db.Uuid
  transportRouteId  String?  @map("transport_route_id") @db.Uuid
  pickupStopId      String?  @map("pickup_stop_id") @db.Uuid
  admissionNumber   String   @map("admission_number") @db.VarChar(100)
  rollNumber        String?  @map("roll_number") @db.VarChar(50)
  firstName         String   @map("first_name") @db.VarChar(100)
  lastName          String?  @map("last_name") @db.VarChar(100)
  dob               String?  @db.VarChar(10)
  gender            String?  @db.VarChar(20)
  bloodGroup        String?  @map("blood_group") @db.VarChar(10)
  aadhaarNumber     String?  @map("aadhaar_number") @db.VarChar(12)
  photoUrl          String?  @map("photo_url") @db.Text
  status            String   @default("Active") @db.VarChar(30)
  customData        Json?    @map("custom_data")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  legacyFirestoreId String?  @map("legacy_firestore_id") @db.VarChar(128)

  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class          Class?              @relation(fields: [classId], references: [id], onDelete: SetNull)
  section        Section?            @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  transportRoute TransportRoute?     @relation(fields: [transportRouteId], references: [id], onDelete: SetNull)
  pickupStop     RouteStop?          @relation(fields: [pickupStopId], references: [id], onDelete: SetNull)
  parents        ParentStudentLink[]

  attendanceRecords   AttendanceRecord[]
  attendanceStats     AttendanceStat[]
  absenteeFlags       AbsenteeFlag[]
  assessmentGrades    AssessmentGrade[]
  reportCards         ReportCard[]
  homeworkSubmissions HomeworkSubmission[]
  invoices            Invoice[]
  bookIssues          LibraryBookIssue[]
  chatRooms           ChatRoom[]
  ptmAppointments     PtmAppointment[]
  canteenRequests     CanteenRequest[]

  @@unique([schoolId, id])
  @@unique([schoolId, admissionNumber])
  @@index([schoolId, classId])
  @@index([schoolId, legacyFirestoreId])
  @@map("students")
}

model ParentProfile {
  id               String   @id @default(uuid()) @db.Uuid
  schoolId         String   @map("school_id") @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  name             String   @db.VarChar(200)
  phone            String?  @db.VarChar(20)
  email            String?  @db.VarChar(255)
  address          String?  @db.Text
  emergencyContact String?  @map("emergency_contact") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  school   School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  children ParentStudentLink[]

  @@unique([schoolId, id])
  @@map("parent_profiles")
}

model StaffProfile {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @map("school_id") @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  employeeId      String?  @map("employee_id") @db.VarChar(100)
  name            String   @db.VarChar(200)
  staffType       String   @default("teaching") @map("staff_type") @db.VarChar(30)
  designation     String?  @db.VarChar(100)
  phone           String?  @db.VarChar(20)
  email           String?  @db.VarChar(255)
  assignedClassId String?  @map("assigned_class_id") @db.Uuid
  baseSalary      Decimal? @default(0) @map("base_salary") @db.Decimal(10, 2)
  status          String   @default("Active") @db.VarChar(30)
  customData      Json?    @map("custom_data")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedClass Class?            @relation("AssignedClassRelation", fields: [assignedClassId], references: [id], onDelete: SetNull)
  headedClasses Class[]           @relation("ClassTeacherRelation")
  payroll       HRPayrollRecord[]
  lessonPlans   LessonPlan[]
  timetables    TimetablePeriod[]
  chatRooms     ChatRoom[]
  ptms          PtmAppointment[]

  @@unique([schoolId, id])
  @@unique([schoolId, employeeId])
  @@map("staff_profiles")
}

model HRPayrollRecord {
  id            String    @id @default(uuid()) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  teacherId     String    @map("teacher_id") @db.Uuid
  month         String    @db.VarChar(20)
  baseSalary    Decimal   @map("base_salary") @db.Decimal(10, 2)
  pfCalculated  Decimal?  @default(0) @map("pf_calculated") @db.Decimal(10, 2)
  esiCalculated Decimal?  @default(0) @map("esi_calculated") @db.Decimal(10, 2)
  deductions    Decimal?  @default(0) @db.Decimal(10, 2)
  netPay        Decimal   @map("net_pay") @db.Decimal(10, 2)
  status        String    @default("Pending") @db.VarChar(30)
  paidAt        DateTime? @map("paid_at")
  customData    Json?     @map("custom_data")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  staffProfile StaffProfile @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@unique([schoolId, teacherId, month])
  @@map("hr_payroll_records")
}

model AttendanceSession {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  classId        String    @map("class_id") @db.Uuid
  sectionId      String?   @map("section_id") @db.Uuid
  date           String    @db.VarChar(10)
  session        String    @default("STANDARD") @db.VarChar(20)
