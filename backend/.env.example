# ============================================================
# School Management System SaaS - Backend Environment Configuration
# ============================================================

# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL 16 Connection URL
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/sms_dev?schema=public"

# Redis 7 Connection URL
REDIS_URL="redis://127.0.0.1:6379"

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cloudinary Configuration (Optional during foundation phase)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Future Phase Secrets (Phase 4B+ Authentication & Security)
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_MASTER_KEY=
ZUNA_SUPPORT_SERVICE_ACCOUNT=

# Firebase Authentication Bridge (Phase 4B.6)
FIREBASE_PROJECT_ID=school-management-system-6a2c4
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# ============================================================
# Transactional Email - Gmail SMTP Transport (Fallback / General)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="School Management System <noreply@schoolmanagement.com>"
FRONTEND_URL="https://school-trio-final-frontend.vercel.app"

# ============================================================
# Temporary Resend HTTPS API (Active for Password Reset Delivery)
# ============================================================
# Used exclusively for forgot-password email delivery over HTTPS (port 443)
# due to Railway container egress firewall blocking ports 465 and 587.
#
# Operator Setup Steps:
# 1. Obtain an API key from https://resend.com/api-keys
# 2. Add and verify your sending domain at https://resend.com/domains (configure SPF/DKIM DNS records)
# 3. For testing before custom domain verification, Resend provides "onboarding@resend.dev"
#    (Note: "onboarding@resend.dev" can only deliver to the email address registered with your Resend account).
# 4. Set RESEND_API_KEY and RESEND_FROM_EMAIL in Railway backend environment variables ONLY.
#    Never commit API keys or expose them to the frontend bundle.
#
# Examples:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL="SchoolTrio <noreply@schooltrio.teamzuna.in>"
RESEND_API_KEY=
RESEND_FROM_EMAIL="School Trio <noreply@teamzuna.in>"

